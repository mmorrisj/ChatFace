# Copy to .env and adjust. All values shown are the defaults.

CHATFACE_HOST=0.0.0.0
CHATFACE_PORT=8000

# Seconds of silence in LISTENING before the session returns to IDLE.
CHATFACE_SILENCE_TIMEOUT_S=20.0

# Max seconds to wait for face identification before starting the
# conversation anyway. The mic never waits on this.
CHATFACE_IDENTITY_TIMEOUT_S=2.0
